{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "shopkit": {
      "type": "streamable-http",
      "url": "https://shopkit-connect.vercel.app/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "shopkit-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "shop:read",
              "offline_access"
            ],
            "defaultScopes": [
              "shop:read",
              "catalog:write",
              "pages:write",
              "shop:publish",
              "offline_access",
              "bookings:read",
              "bookings:manage"
            ]
          }
        }
      }
    }
  }
}
